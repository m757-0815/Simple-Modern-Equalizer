import { Button, CheckBox, ComboBox, LineEdit, ScrollView, Slider, SpinBox, Spinner, TextEdit } from "std-widgets.slint";
import "fonts/Inter-Light.ttf";

global Graphite {
    out property <color> window: #15181D;
    out property <color> border: #2D3139;
    out property <color> divider: #4B5059;
    out property <color> text: #F2F2F4;
    out property <color> secondary: #BCBCC4;
    out property <length> panel-inset: 14px;
    out property <length> control-gap: 8px;
}

component PanelHeading inherits Text {
    accessible-label: self.text;
    color: Graphite.text;
    font-size: 19px;
    vertical-alignment: center;
}

component Panel inherits Rectangle {
    background: Graphite.window;
    border-color: Graphite.border;
    border-width: 1px;
    border-radius: 14px;
}

export global Appearance {
    pure callback parse-color(string, color) -> color;
    pure callback format-color(color) -> string;
    out property <string> default-accent-hex: "#39C98A";
    in-out property <color> accent: #39C98A;
    in-out property <string> accent-hex: self.default-accent-hex;
    in-out property <image> app-icon: @image-url("icons/app-icon.png");
}

component ColorSwatch inherits Rectangle {
    in property <color> swatch;
    in property <string> label;
    in property <string> hint;
    callback clicked <=> button.clicked;
    width: 28px;
    height: 23px;
    button := Button {
        width: parent.width;
        height: parent.height;
        accessible-label: root.label;
    }
    Rectangle {
        x: 5px; y: 4px; width: parent.width - 10px; height: parent.height - 8px;
        border-radius: 3px;
        background: root.swatch;
    }
    Tooltip { text: @markdown("\{root.hint}"); }
}

component ColorField inherits VerticalLayout {
    in property <string> label;
    in property <color> swatch;
    in-out property <string> value <=> input.text;
    callback accepted();
    private property <float> hue;
    private property <float> saturation;
    private property <float> brightness;
    private property <int> tab: 1;
    private property <color> selection: rgb(0,0,0);
    function load(c: color) {
        let hsv = c.to-hsv();
        root.hue = hsv.hue;
        root.saturation = hsv.saturation;
        root.brightness = hsv.value;
        root.selection = c;
    }
    function update() {
        root.selection = hsv(root.hue, root.saturation, root.brightness);
        root.pending-color = root.selection;
        root.pending-hex = Appearance.format-color(root.selection);
        root.value = root.pending-hex;
    }
    private property <string> pending-hex;
    private property <color> pending-color;
    min-width: 0px;
    horizontal-stretch: 1;
    spacing: 4px;
    HorizontalLayout {
        spacing: 6px;
        ColorSwatch {
            label: root.label + " color picker";
            swatch: root.pending-hex == root.value && root.value != "" ? root.pending-color : root.swatch;
            clicked => { root.load(Appearance.parse-color(root.value, root.swatch)); picker.show(); }
            hint: "Choose a color from the wheel.";
        }
        Text { text: root.label; color: Graphite.secondary; font-size: 12px; vertical-alignment: center; }
    }
    input := LineEdit {
        min-width: 0px;
        accessible-label: root.label + " color";
        placeholder-text: "#RRGGBB";
        accepted => { root.accepted(); }
        Tooltip { text: @markdown("Enter a six-digit hex color, for example `#39C98A`."); }
    }
    picker := PopupWindow {
        width: 222px; height: 295px;
        x: 0px; y: 26px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Graphite.window; border-radius: 6px;
            border-width: 1px; border-color: Graphite.border;
            VerticalLayout {
                padding: 9px; spacing: 5px;
                HorizontalLayout {
                    height: 168px; spacing: 8px;
                    wheel := Rectangle {
                        width: 168px; height: 168px;
                        Image { width: 100%; height: 100%; source: @image-url("icons/color-wheel.png"); }
                        Rectangle { border-radius: 84px; background: black; opacity: 1 - root.brightness; }
                        Rectangle {
                            width: 8px; height: 8px; border-radius: 4px;
                            x: 80px - 84px * root.saturation * sin(root.hue * 1deg);
                            y: 80px + 84px * root.saturation * cos(root.hue * 1deg);
                            border-width: 1px; border-color: black; background: white;
                        }
                        TouchArea {
                            accessible-role: slider; accessible-label: "Hue and saturation wheel";
                            function select-point() {
                                let dx = (self.mouse-x - 84px) / 84px;
                                let dy = (self.mouse-y - 84px) / 84px;
                                root.hue = mod(360 - atan2(dx, dy) / 1deg, 360);
                                root.saturation = min(1, sqrt(dx*dx + dy*dy));
                                root.update();
                            }
                            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { self.select-point(); } }
                            moved => { if (self.pressed) { self.select-point(); } }
                        }
                    }
                    Rectangle {
                        width: 20px; height: 168px; border-radius: 3px;
                        background: @linear-gradient(180deg, white, black);
                        Rectangle { y: (parent.height - 3px) * (1-root.brightness); height: 3px; border-width: 1px; border-color: black; background: white; }
                        TouchArea {
                            function adjust() { root.brightness = clamp(1-self.mouse-y/self.height,0,1); root.update(); }
                            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { self.adjust(); } }
                            moved => { if (self.pressed) { self.adjust(); } }
                        }
                    }
                }
                HorizontalLayout {
                    height: 25px;
                    for title[i] in ["RGB", "HSV", "Hex"]: Button {
                        text: title; primary: root.tab == i; clicked => { root.tab = i; }
                    }
                }
                if root.tab != 2: VerticalLayout {
                    for channel[i] in (root.tab == 1 ? ["H","S","V"] : ["R","G","B"]): HorizontalLayout {
                        Text { text: channel; color: Graphite.text; width: 16px; }
                        adjuster := Slider {
                            accessible-label: channel;
                            minimum: 0; maximum: root.tab == 0 ? 255 : i == 0 ? 360 : 100;
                            value: root.tab == 0 ? (i == 0 ? root.selection.red : i == 1 ? root.selection.green : root.selection.blue)
                                : (i == 0 ? root.hue : 100*(i == 1 ? root.saturation : root.brightness));
                            changed(v) => {
                                if (root.tab == 0) {
                                    root.load(rgb(i == 0 ? round(v) : root.selection.red, i == 1 ? round(v) : root.selection.green, i == 2 ? round(v) : root.selection.blue));
                                } else if (i == 0) { root.hue = v; }
                                else if (i == 1) { root.saturation = v/100; }
                                else { root.brightness = v/100; }
                                root.update();
                            }
                        }
                        Text { width: 32px; color: Graphite.secondary; horizontal-alignment: right; text: round(adjuster.value); }
                    }
                }
                if root.tab == 2: LineEdit {
                    accessible-label: "Picker hex"; text <=> root.value;
                    edited => { root.load(Appearance.parse-color(self.text,root.selection)); root.pending-color = root.selection; root.pending-hex = self.text; }
                }
                Button { height: 25px; text: "Done"; clicked => { picker.close(); root.accepted(); } }
            }
        }
    }
}

export struct BandRow {
    frequency: string,
    gain: float,
    gain-label: string,
    q: string,
    kind: int,
    enabled: bool,
    locked: bool,
}

export struct GraphDot {
    x: float,
    y: float,
    enabled: bool,
}

export struct FrequencyTick {
    position: float,
    label: string,
}

export struct FrequencyRegion {
    start: float,
    end: float,
}

export struct ToneClipping {
    bass: bool,
    mid: bool,
    treble: bool,
}

export struct PlotExtent {
    width: float,
    height: float,
}

export struct PlaybackDetails {
    title: string,
    artist: string,
}

component PlotArea inherits Rectangle {
    callback extent-changed(PlotExtent);
    private property <PlotExtent> extent: { width: self.width / 1px, height: self.height / 1px };
    init => { root.extent-changed(self.extent); }
    changed extent => { root.extent-changed(self.extent); }
}

component Label inherits Text {
    color: Graphite.secondary;
    font-size: 12px;
    vertical-alignment: center;
}

component GraphLabel inherits Label {
    font-size: 11px;
    letter-spacing: 0.4px;
}

component NowPlayingPanel inherits Panel {
    in property <PlaybackDetails> details;
    VerticalLayout {
        padding-left: Graphite.panel-inset;
        padding-right: Graphite.panel-inset;
        spacing: 3px;
        alignment: center;
        GraphLabel { text: "NOW PLAYING"; color: Appearance.accent; }
        Label {
            text: root.details.artist == "" ? root.details.title : root.details.title + " · " + root.details.artist;
            accessible-label: self.text;
            color: Graphite.text;
            font-size: 14px;
            min-width: 0px;
            overflow: elide;
        }
    }
}

component Choice inherits Rectangle {
    in property <[string]> model <=> input.model;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    in-out property <int> current-index <=> input.current-index;
    callback selected <=> input.selected;
    min-width: input.min-width;
    min-height: input.min-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: input;
    input := ComboBox {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        accessible-label: root.accessible-name;
    }
    Rectangle {
        x: parent.width - 31px;
        y: (parent.height - self.height) / 2;
        width: 26px;
        height: parent.height - 4px;
        border-radius: 4px;
        background: Graphite.window;
        Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 8px; height: 11px;
            stroke: root.enabled ? Appearance.accent : Graphite.secondary;
            stroke-width: 1.5px;
            opacity: root.enabled ? 1 : 0.65;
            commands: "M 0 3.5 L 4 0 L 8 3.5 M 0 7.5 L 4 11 L 8 7.5";
        }
    }
}

component ResizeGrip inherits Rectangle {
    in-out property <float> panel-height;
    in property <float> minimum;
    in property <float> maximum;
    in property <string> label;
    callback resizing();
    callback resized();
    height: 12px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.panel-height;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum > 0 ? root.maximum : 2147483648;
    accessible-action-increment => { root.resize(root.panel-height + 10); }
    accessible-action-decrement => { root.resize(root.panel-height - 10); }

    function resize(height: float) {
        let next = root.maximum > 0 ? clamp(round(height), root.minimum, root.maximum)
            : max(round(height), root.minimum);
        if (next != root.panel-height) {
            root.resizing();
            root.panel-height = next;
            root.resized();
        }
    }

    Rectangle {
        width: 42px; height: 3px; border-radius: 2px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: grip.has-hover || grip.pressed ? Appearance.accent : Graphite.secondary;
    }
    Tooltip { text: @markdown("Drag the bottom edge to resize."); }
    grip := TouchArea {
        mouse-cursor: ns-resize;
        private property <length> start-y;
        private property <float> start-height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.start-y = self.absolute-position.y + self.mouse-y;
                self.start-height = root.panel-height;
            }
        }
        moved => {
            if self.pressed {
                // The grip moves with the panel. Measure the drag in window coordinates.
                root.resize(self.start-height + (self.absolute-position.y + self.mouse-y - self.start-y) / 1px);
            }
        }
    }
}

component ToneFader inherits Rectangle {
    in property <string> label;
    in property <bool> clip-affected;
    in-out property <float> gain;
    callback edited(float);
    callback finished();
    height: 146px;

    function set-gain(value: float) {
        let gain = round(clamp(value, -12, 12) * 2) / 2;
        root.gain = gain;
        root.edited(gain);
    }

    face := Rectangle {
        width: 128px; height: parent.height;
        private property <length> top-travel: 10px;
        private property <length> travel: self.height - 2 * self.top-travel;
        private property <length> lever-y: self.top-travel + (12 - root.gain) / 24 * self.travel;

        Rectangle {
            x: 59px; y: 3px;
            width: 10px; height: parent.height - 6px; border-radius: 5px;
            background: Graphite.window;
            border-width: 1px; border-color: Graphite.divider;
        }
        for level[index] in ["+12", "+6", "0", "−6", "−12"]: Rectangle {
            width: parent.width; height: 16px;
            y: face.top-travel + index / 4.0 * face.travel - self.height / 2;
            Rectangle {
                x: index == 2 ? 36px : 43px;
                y: 7px;
                width: index == 2 ? 16px : 9px; height: 1px;
                background: index == 2 ? Appearance.accent : #696971;
            }
            GraphLabel {
                x: 88px; y: 0px; width: 40px; height: parent.height;
                text: level;
                color: index == 2 ? Appearance.accent : Graphite.secondary;
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: face.lever-y - self.height / 2;
            width: 38px; height: 20px; border-radius: 4px;
            background: Graphite.window;
            border-width: 1px;
            border-color: input.has-focus || root.clip-affected ? Appearance.accent : #919198;
            Rectangle {
                x: 7px; y: (parent.height - self.height) / 2;
                width: parent.width - 14px; height: 2px; border-radius: 1px;
                background: Appearance.accent;
            }
        }
        // Keep the native slider's pointer, keyboard, and accessibility handling.
        input := Slider {
            x: 40px; y: 0px;
            width: 48px; height: parent.height;
            opacity: 0;
            accessible-label: root.label;
            orientation: vertical;
            minimum: -12;
            maximum: 12;
            step: 0.5;
            value <=> root.gain;
            changed(value) => { root.set-gain(value); }
            released => { root.finished(); }
        }
        TouchArea {
            x: 40px; y: 0px;
            width: 48px; height: parent.height;
            private property <float> start-gain;
            private property <bool> grabbed;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    self.start-gain = root.gain;
                    self.grabbed = abs(self.mouse-y - face.lever-y) <= 10px;
                    input.focus();
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.finished();
                }
            }
            moved => {
                if (self.pressed) {
                    let value = self.grabbed
                        ? self.start-gain + (self.pressed-y - self.mouse-y) * 24 / face.travel
                        : 12 - (self.mouse-y - face.top-travel) * 24 / face.travel;
                    root.set-gain(value);
                }
            }
            clicked => {
                if (!self.grabbed && abs(self.mouse-y - self.pressed-y) < 2px) {
                    root.set-gain(12 - (self.mouse-y - face.top-travel) * 24 / face.travel);
                }
                root.finished();
            }
            double-clicked => { root.set-gain(0); root.finished(); }
        }
    }
}

component ToneControl inherits Rectangle {
    in property <string> label;
    in property <bool> clip-affected;
    in-out property <float> gain;
    callback edited(float);
    callback finished();
    background: Graphite.window;
    border-color: root.clip-affected ? Appearance.accent : Graphite.border;
    border-width: 1px;
    border-radius: 12px;
    min-width: 128px;
    horizontal-stretch: 1;
    height: 232px;
    Tooltip { text: @markdown("Drag to adjust in 0.5 dB steps. Double-click the lever to reset."); }
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        Label {
            text: root.clip-affected ? root.label + " · CLIP" : root.label;
            accessible-label: self.text;
            color: root.clip-affected ? Appearance.accent : Graphite.secondary;
            horizontal-alignment: center;
            font-size: 14px;
        }
        GraphLabel {
            text: (root.gain > 0 ? "+" : "") + root.gain + " dB";
            color: Appearance.accent;
            font-size: 23px;
            horizontal-alignment: center;
        }
        ToneFader {
            label: root.label;
            clip-affected: root.clip-affected;
            gain <=> root.gain;
            edited(value) => { root.gain = value; root.edited(value); }
            finished => { root.finished(); }
        }
    }
}

component PreampControls inherits VerticalLayout {
    in-out property <float> preamp;
    in-out property <string> preamp-entry;
    in-out property <bool> auto-headroom;
    in property <string> preamp-label;
    in property <bool> locked;
    callback change-preamp(float);
    callback enter-preamp(string);
    callback change-headroom(bool);
    callback finished();
    min-width: 340px;
    spacing: 5px;
    HorizontalLayout {
        spacing: 7px;
        Label { text: "PREAMP"; }
        CheckBox {
            text: "Auto Headroom"; width: 132px; checked <=> root.auto-headroom;
            toggled => { root.change-headroom(self.checked); }
            Tooltip { text: @markdown("Replace the manual preamp with calculated headroom. Turning this off keeps that gain within the manual range."); }
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "−"; width: 27px; accessible-label: "Decrease preamp";
            enabled: !root.auto-headroom && !root.locked;
            clicked => { root.change-preamp(root.preamp - 0.05); root.finished(); }
            Tooltip { text: @markdown("Decrease preamp by 0.05 dB."); }
        }
        LineEdit {
            width: 63px; text <=> root.preamp-entry; accessible-label: "Preamp in dB";
            enabled: !root.auto-headroom && !root.locked;
            accepted => { root.enter-preamp(self.text); }
            Tooltip { text: @markdown("Enter gain in dB and press Enter."); }
        }
        Button {
            text: "+"; width: 27px; accessible-label: "Increase preamp";
            enabled: !root.auto-headroom && !root.locked;
            clicked => { root.change-preamp(root.preamp + 0.05); root.finished(); }
            Tooltip { text: @markdown("Increase preamp by 0.05 dB."); }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Slider {
            enabled: !root.auto-headroom && !root.locked;
            minimum: -12; maximum: 12; step: 0.05; value <=> root.preamp;
            accessible-label: "Preamp";
            changed(value) => { root.change-preamp(value); }
            released => { root.finished(); }
            Tooltip { text: @markdown("Adjust the gain applied before the EQ filters."); }
        }
        Label { text: root.preamp-label; color: Appearance.accent; }
    }
}

export component MainWindow inherits Window {
    title: "Simple Modern Equalizer";
    icon: Appearance.app-icon;
    preferred-width: 1120px;
    preferred-height: 920px;
    min-width: 480px;
    min-height: 360px;
    background: Graphite.window;
    default-font-family: "Inter Light";
    default-font-weight: 300;
    default-font-size: 14px;
    forward-focus: window-keys;
    private property <bool> narrow: self.width < 820px;
    private property <bool> short: self.height < 500px;
    private property <length> page-inset: self.narrow ? 10px : 18px;
    private property <length> graph-axis-inset: self.narrow ? 42px : 58px;
    private property <bool> open-short-monitor;
    out property <bool> live-monitor-expanded: root.show-live-view && (!root.short || root.open-short-monitor);
    private property <length> graph-height: (self.short
        ? min(self.eq-plot-height, max(112, (self.height - 252px) / 1px)) : self.eq-plot-height) * 1px;
    in property <string> app-version;
    in property <string> source-license;
    in property <string> license-text;
    private property <bool> show-about-license;
    in property <[BandRow]> bands;
    in property <[GraphDot]> graph-dots;
    in-out property <int> selected-point: -1;
    in property <[string]> presets;
    in property <[string]> outputs;
    in property <bool> can-rename;
    in property <bool> can-assign;
    in property <bool> can-unassign;
    in property <string> active-output-label;
    in property <string> output-mapping;
    in-out property <bool> auto-headroom;
    in property <bool> clipping;
    in property <[FrequencyRegion]> clip-regions;
    in property <ToneClipping> simple-clipping;
    private property <bool> show-simple-clip: root.show-clipping && root.clipping;
    in property <float> output-peak-dbfs: -1000;
    in property <bool> listening-to-a;
    in-out property <int> preset-index: 0;
    in-out property <int> output-index: 0;
    in-out property <int> phase-mode-index: 0;
    private property <[string]> phase-mode-names: ["Minimum Phase", "Matched Phase", "Linear Phase", "Zero Phase (Beta)"];
    in property <[string]> phase-mode-details: ["", "", "", ""];
    private property <string> phase-mode-detail: root.phase-mode-index >= 0 && root.phase-mode-index < root.phase-mode-details.length
        ? root.phase-mode-details[root.phase-mode-index] : "";
    in property <string> phase-mode-error;
    in-out property <int> band-count: 5;
    in-out property <float> preamp;
    in-out property <float> balance;
    in-out property <bool> bypass;
    in-out property <bool> show-live-view: true;
    in property <bool> has-now-playing: true;
    in property <PlaybackDetails> playback-details: {
        title: "No track reported", artist: ""
    };
    in-out property <bool> show-band-list: true;
    in property <bool> spline-eq;
    in-out property <bool> show-levels: true;
    in-out property <bool> show-clipping: true;
    in-out property <bool> show-preset-button: true;
    in-out property <bool> show-eq-spectrum;
    in-out property <bool> fullscreen-enabled;
    in property <bool> has-login-start;
    in-out property <bool> login-start;
    private property <string> login-start-error;
    callback change-login-start(bool) -> string;
    callback change-full-screen(bool);
    callback change-colors(string) -> string;
    callback toggle-eq-mode();
    in property <bool> fitting-eq;
    private property <string> fitting-message: "Optimizing EQ curve…";
    in property <string> fit-detail;
    in property <bool> can-undo;
    callback undo();
    callback finish-edit();
    function set-fullscreen-mode(enabled: bool) {
        root.fullscreen-enabled = enabled;
        root.change-full-screen(enabled);
        if (enabled) {
            window-keys.focus();
        }
    }
    in property <string> preamp-label;
    in-out property <string> preamp-entry;
    in property <string> balance-label;
    in property <bool> graph-edited;
    in property <string> status: "Starting audio engine…";
    in property <string> notice;
    in property <bool> connected: false;
    in property <string> signal: "Waiting for audio";
    in property <string> scope-status: "Waiting for output capture";
    in property <image> graph;
    in-out property <int> eq-range-db: 24;
    in property <string> eq-bottom-db: "-24";
    in property <string> eq-top-db: "+24";
    in property <float> eq-zero-position: 0.5;
    in property <image> live-image;
    in property <image> monitor-image;
    in property <string> monitor-status;
    out property <PlotExtent> eq-plot-extent;
    out property <PlotExtent> live-plot-extent;
    in property <[FrequencyTick]> live-frequency-ticks;
    in-out property <int> live-mode: 0;
    in property <float> left-level-dbfs: -1000;
    in property <float> right-level-dbfs: -1000;
    in-out property <float> live-view-height: 216;
    in-out property <float> eq-plot-height: 260;
    in-out property <bool> simple-layout;
    in-out property <float> simple-bass;
    in-out property <float> simple-mid;
    in-out property <float> simple-treble;
    in-out property <bool> simple-loudness;
    callback change-layout(bool);
    callback change-eq-range();
    callback save-graph-view();
    callback change-tone(float, float, float, bool);
    callback choose-preset(int);
    callback resolve-preset-load(bool);
    private property <string> preset-load-name;
    private property <bool> preset-load-import;
    public function warn-preset-load(name: string, importing: bool) {
        preset-menu.close();
        root.preset-load-name = name;
        root.preset-load-import = importing;
        preset-load-warning.show();
    }
    public function dismiss-presets() {
        preset-menu.close();
        preset-load-warning.close();
    }
    function finish-preset-load(confirmed: bool) {
        preset-load-warning.close();
        root.resolve-preset-load(confirmed);
    }
    callback name-preset(bool, string) -> string;
    callback overwrite-preset() -> string;
    private property <string> preset-overwrite-message;
    callback assign-preset(bool);
    callback change-headroom(bool);
    callback capture-a();
    callback listen-a(bool);
    callback clear-reference();
    callback choose-output(int);
    callback change-phase-mode(int);
    callback change-count(int);
    callback delete-band(int);
    callback resolve-band-removal(bool);
    private property <string> band-removal-message;
    public function warn-band-removal(keep: int, current: int, protected: int) {
        root.band-removal-message = "Reducing the count to " + keep + " removes the highest-frequency bands. "
            + protected + " of the " + (current - keep) + " bands being removed "
            + (protected == 1 ? "has" : "have") + " been edited or came from an older or imported preset.";
        band-removal.show();
    }
    public function warn-single-band-removal(number: int) {
        root.band-removal-message = (root.spline-eq ? "Spline point " : "Band ") + number
            + " was edited or came from an older or imported preset.";
        band-removal.show();
    }
    callback change-preamp(float);
    callback enter-preamp(string);
    callback change-balance(float);
    callback change-bypass(bool);
    callback change-live-view(bool);
    callback edit-band-number(int, bool, string);
    callback edit-band-gain(int, float);
    callback edit-band-kind(int, int);
    callback edit-band-enabled(int, bool);
    callback hit-band(float, float, float, float) -> int;
    callback add-band(float, float, float, float);
    callback delete-band-at(float, float, float, float);
    callback move-band(int, float, float) -> int;
    private property <int> drag-generation;
    public function cancel-graph-drag() { root.drag-generation += 1; }
    public function clear-point-selection() {
        root.cancel-graph-drag();
        root.selected-point = -1;
    }
    callback import-apo();
    callback save-config();
    callback export-apo();

    private property <length> eq-resize-scroll-floor;
    changed simple-layout => { window-scroll.content-y = 0px; }
    window-keys := FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if (root.fullscreen-enabled && event.text == Key.Escape) {
                root.set-fullscreen-mode(false);
                return accept;
            }
            return reject;
        }
    window-scroll := ScrollView {
        y: root.simple-layout ? top-controls.height + root.page-inset : 0px;
        height: parent.height - self.y;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: max(page.height, root.eq-resize-scroll-floor);
        scrolled => { root.eq-resize-scroll-floor = 0px; }
        changed content-height => {
            self.content-y = max(self.content-y, self.visible-height - self.content-height);
        }

    page := VerticalLayout {
        y: 0px;
        width: window-scroll.content-width;
        height: max(window-scroll.visible-height, self.min-height);
        padding: root.page-inset;
        padding-top: root.simple-layout ? 10px : top-controls.height + root.page-inset + 14px;
        spacing: root.simple-layout ? 10px : 14px;
        if root.live-monitor-expanded: live-view := Panel {
            height: root.live-view-height * 1px;
            VerticalLayout {
                padding: Graphite.panel-inset;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 5px;
                HorizontalLayout {
                    spacing: root.narrow ? 6px : 10px;
                    cross-axis-alignment: center;
                    PanelHeading { text: "Live Monitor"; }
                    if !root.narrow && root.live-mode == 0: GraphLabel {
                        text: root.signal;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if !root.narrow: GraphLabel {
                        text: root.live-mode == 1 ? "MONO OUTPUT · ±1 FULL SCALE"
                            : root.live-mode == 2 ? "STEREO LEVEL · dBFS RMS"
                            : root.live-mode == 3 ? "−66 TO 0 dBFS"
                            : root.live-mode == 4 ? "OUTPUT RMS · −60 TO 0 dBFS"
                            : root.live-mode == 5 ? root.monitor-status : "RELATIVE LEVEL";
                        horizontal-alignment: right;
                    }
                    if root.show-clipping && !root.narrow: GraphLabel {
                        text: "CLIP";
                        color: root.clipping ? Appearance.accent : Graphite.secondary;
                        accessible-label: root.clipping ? "Output peak reached full scale" : "No recent clipping";
                    }
                    Choice {
                        width: 182px;
                        accessible-name: "Live display";
                        model: ["Bars", "Oscilloscope", "Stereo Level", "Before / After EQ", "Loudness History", "Stereo Field"];
                        current-index <=> root.live-mode;
                        Tooltip { text: @markdown("Choose the visualization for Live Monitor."); }
                    }
                }
                live-plot := PlotArea {
                    border-radius: 6px; clip: true; vertical-stretch: 1;
                    extent-changed(extent) => { root.live-plot-extent = extent; }
                    if root.live-mode != 2: Image {
                        width: parent.width; height: parent.height;
                        source: root.live-mode >= 3 ? root.monitor-image : root.live-image;
                        image-fit: fill;
                    }
                    if root.live-mode >= 3 && root.monitor-status != "" && root.live-mode != 5: GraphLabel {
                        x: 12px; y: 7px;
                        text: root.monitor-status;
                    }
                    if root.live-mode == 2: VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 5px;
                        alignment: center;
                        for level[index] in [root.left-level-dbfs, root.right-level-dbfs]: HorizontalLayout {
                            height: 14px;
                            spacing: 8px;
                            cross-axis-alignment: center;
                            GraphLabel { text: index == 0 ? "LEFT" : "RIGHT"; width: 48px; color: Appearance.accent; }
                            track := Rectangle {
                                horizontal-stretch: 1;
                                height: 10px;
                                border-radius: 5px;
                                background: Graphite.divider;
                                clip: true;
                                Rectangle {
                                    x: 0px; y: 0px; height: parent.height;
                                    width: parent.width * clamp((level + 60) / 60, 0, 1);
                                    clip: true;
                                    Rectangle {
                                        x: 0px; y: 0px; width: track.width; height: track.height;
                                        background: Appearance.accent;
                                    }
                                }
                            }
                            GraphLabel {
                                text: level <= -1000 ? "−∞" : "" + round(level * 10) / 10;
                                width: 54px;
                                horizontal-alignment: right;
                                color: Graphite.text;
                                accessible-label: (index == 0 ? "Left level: " : "Right level: ") + self.text + " dBFS";
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { width: 48px; }
                            stereo-scale := Rectangle {
                                height: 16px;
                                horizontal-stretch: 1;
                                for tick[index] in ["−60", "−48", "−36", "−24", "−12", "0"]: GraphLabel {
                                    width: 30px;
                                    height: parent.height;
                                    x: clamp(index * parent.width / 5 - self.width / 2, 0px, parent.width - self.width);
                                    text: tick;
                                    horizontal-alignment: index == 0 ? left : index == 5 ? right : center;
                                }
                            }
                            Rectangle { width: 54px; }
                        }
                    }
                }
                if root.live-mode == 0 || root.live-mode == 3: Rectangle {
                    height: 16px;
                    for tick in root.live-frequency-ticks: GraphLabel {
                        width: 48px;
                        x: clamp(tick.position * parent.width - self.width / 2, 0px, parent.width - self.width);
                        text: tick.label;
                        horizontal-alignment: tick.position == 0 ? left : tick.position == 1 ? right : center;
                    }
                }
                if root.live-mode == 3: HorizontalLayout {
                    spacing: 12px;
                    GraphLabel { text: "━ Before EQ"; color: Appearance.accent.transparentize(0.40); }
                    GraphLabel { text: "━ After EQ"; color: Appearance.accent; }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.live-mode == 4: Rectangle {
                    height: 16px;
                    for tick[index] in ["30 s ago", "20 s", "10 s", "Now"]: GraphLabel {
                        width: 54px;
                        x: clamp(index * parent.width / 3 - self.width / 2, 0px, parent.width - self.width);
                        text: tick;
                        horizontal-alignment: index == 0 ? left : index == 3 ? right : center;
                    }
                }
                if root.live-mode == 5: HorizontalLayout {
                    GraphLabel { text: "HORIZONTAL · SIDE (R−L)"; }
                    if root.narrow: GraphLabel { text: root.monitor-status; horizontal-alignment: center; }
                    GraphLabel { text: "VERTICAL · MID (L+R)"; horizontal-alignment: right; }
                }
                if root.live-mode == 1 || root.live-mode == 2: HorizontalLayout {
                    if root.live-mode == 2: live-status := GraphLabel { text: root.signal; }
                    if root.live-mode == 1: GraphLabel { text: "0 ms"; }
                    if root.live-mode == 1: GraphLabel { text: root.scope-status; horizontal-alignment: center; }
                    if root.live-mode == 1: GraphLabel { text: "20 ms"; horizontal-alignment: right; }
                }
                ResizeGrip {
                    panel-height <=> root.live-view-height; minimum: 146; maximum: 420;
                    label: "Live Monitor height"; resized => { root.save-graph-view(); }
                }
            }
        }
        if root.simple-layout: tone-panel := Panel {
            vertical-stretch: 0;
            VerticalLayout {
                padding: Graphite.panel-inset; spacing: Graphite.control-gap;
                HorizontalLayout {
                    spacing: 12px;
                    cross-axis-alignment: center;
                    PanelHeading { text: "Tone Controls"; }
                    CheckBox {
                        text: "Loudness"; checked <=> root.simple-loudness;
                        Tooltip { text: @markdown("Boost bass and treble for quieter listening."); }
                        toggled => { root.change-tone(root.simple-bass, root.simple-mid, root.simple-treble, self.checked); }
                    }
                    if root.show-simple-clip && !root.simple-clipping.bass
                        && !root.simple-clipping.mid && !root.simple-clipping.treble: GraphLabel {
                        text: "OUTPUT CLIPPING";
                        accessible-label: self.text;
                        color: Appearance.accent;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 12px;
                    ToneControl {
                        label: "Bass"; gain <=> root.simple-bass;
                        clip-affected: root.show-simple-clip && root.simple-clipping.bass;
                        edited(value) => { root.change-tone(value, root.simple-mid, root.simple-treble, root.simple-loudness); }
                        finished => { root.finish-edit(); }
                    }
                    ToneControl {
                        label: "Mid"; gain <=> root.simple-mid;
                        clip-affected: root.show-simple-clip && root.simple-clipping.mid;
                        edited(value) => { root.change-tone(root.simple-bass, value, root.simple-treble, root.simple-loudness); }
                        finished => { root.finish-edit(); }
                    }
                    ToneControl {
                        label: "Treble"; gain <=> root.simple-treble;
                        clip-affected: root.show-simple-clip && root.simple-clipping.treble;
                        edited(value) => { root.change-tone(root.simple-bass, root.simple-mid, value, root.simple-loudness); }
                        finished => { root.finish-edit(); }
                    }
                }
            }
        }
        if !root.simple-layout: eq-graph-panel := Panel {
            background: Graphite.window;
            height: root.graph-height + (root.show-clipping ? 175px : 136px) - (root.short ? 23px : 0px);
            VerticalLayout {
                padding: Graphite.panel-inset; padding-bottom: root.short ? 10px : 33px; spacing: 7px;
                HorizontalLayout {
                    height: 28px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    graph-title := PanelHeading {
                        text: "Equalizer Graph";
                        min-width: 0px;
                        overflow: elide;
                    }
                    Button {
                        text: root.fitting-eq ? "Fitting…" : root.spline-eq ? "Use Parametric" : "Use Spline";
                        accessible-label: self.text + " From EQ Graph";
                        enabled: !root.listening-to-a && !root.fitting-eq;
                        Tooltip { text: @markdown("Switch editors and keep the current EQ curve."); }
                        clicked => { root.toggle-eq-mode(); }
                    }
                    if root.graph-edited && !root.narrow: GraphLabel { text: "Edited"; }
                    if root.fit-detail != "" && !root.narrow: GraphLabel {
                        text: root.fit-detail;
                        Tooltip { text: @markdown("Largest difference from the reference curve on the fitting grid."); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    GraphLabel { text: "± dB"; }
                    SpinBox {
                        width: 68px;
                        minimum: 1;
                        maximum: 24;
                        value <=> root.eq-range-db;
                        accessible-label: "EQ graph range in dB";
                        Tooltip { text: @markdown("Set the gain range above and below the graph center. Smaller values make vertical adjustments finer."); }
                        edited(value) => {
                            root.change-eq-range();
                            root.save-graph-view();
                        }
                    }
                }
                HorizontalLayout {
                    height: 17px;
                    spacing: 8px;
                    GraphLabel { text: root.spline-eq ? "Spline EQ" : "Parametric EQ"; color: Appearance.accent; }
                    if root.fit-detail != "" && root.narrow: GraphLabel {
                        text: root.fit-detail;
                        Tooltip { text: @markdown("Largest difference from the reference curve on the fitting grid."); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.show-clipping && root.clipping && root.clip-regions.length > 0: GraphLabel {
                        text: "Strong Bands At Clip"; color: Appearance.accent;
                        Tooltip { text: @markdown("Strong output frequencies during the clip. Digital clipping affects the whole waveform."); }
                    }
                    GraphLabel {
                        text: root.bypass ? "EQ Off" : "Including Preamp";
                        Tooltip { text: @markdown("Preamp shifts the whole response up or down in dB."); }
                    }
                }
                HorizontalLayout {
                    height: root.graph-height;
                    Rectangle {
                        width: root.graph-axis-inset;
                        GraphLabel { text: root.eq-top-db; y: 0px; }
                        GraphLabel {
                            text: "0 dB";
                            visible: root.eq-zero-position > 0.05 && root.eq-zero-position < 0.95;
                            y: parent.height * root.eq-zero-position - self.height / 2;
                        }
                        GraphLabel { text: root.eq-bottom-db; y: parent.height - self.height; }
                    }
                    plot := PlotArea {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        z: 1;
                        extent-changed(extent) => { root.eq-plot-extent = extent; }
                        Tooltip { text: root.spline-eq
                            ? @markdown("Drag a point to edit it. Hold Shift for finer movement. Double-click to add a point. Right-click to remove an interior point.")
                            : @markdown("Drag a band to edit it. Hold Shift for finer movement. Double-click to add a peak filter. Right-click a band to remove it."); }
                        private property <int> dragging: -1;
                        private property <int> pressed-generation: -1;
                        private property <int> active-drag: self.pressed-generation == root.drag-generation ? self.dragging : -1;
                        private property <length> handle-size: min(self.width * 0.027, 20px);

                        Rectangle {
                            width: parent.width; height: parent.height;
                            border-width: 1px; border-color: Graphite.border;
                            border-radius: 6px; clip: true;
                            Image { width: parent.width; height: parent.height; source: root.graph; image-fit: fill; }
                        }
                        if root.show-clipping && root.clipping: Rectangle {
                            width: parent.width; height: parent.height; clip: true;
                            for region in root.clip-regions: Rectangle {
                                x: region.start * parent.width;
                                width: (region.end - region.start) * parent.width;
                                height: parent.height;
                                background: Appearance.accent.transparentize(0.82);
                            }
                        }
                        for dot[index] in root.graph-dots: graph-handle := Rectangle {
                            width: plot.handle-size; height: self.width; border-radius: self.width / 2;
                            x: dot.x * parent.width - self.width / 2;
                            y: clamp(dot.y, 0, 1) * parent.height - self.height / 2;
                            border-width: root.selected-point == index ? 2px : 1px;
                            border-color: root.selected-point == index || dot.enabled ? Appearance.accent : Graphite.divider;
                            background: dot.enabled && plot.active-drag == index ? Appearance.accent : Graphite.window;
                            if plot.handle-size >= 15px: GraphLabel {
                                text: index + 1;
                                color: dot.enabled && plot.active-drag == index ? Graphite.window
                                    : root.selected-point == index ? Appearance.accent : dot.enabled ? Graphite.text : Graphite.secondary;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }
                        if root.selected-point >= 0 && root.selected-point < root.graph-dots.length
                            && root.selected-point < root.bands.length: point-readout := Rectangle {
                            private property <GraphDot> dot: root.graph-dots[root.selected-point];
                            private property <BandRow> band: root.bands[root.selected-point];
                            private property <length> point-y: clamp(self.dot.y, 0, 1) * parent.height;
                            width: value.preferred-width + 16px;
                            height: 25px;
                            x: clamp(self.dot.x * parent.width + 14px, 4px, parent.width - self.width - 4px);
                            y: self.point-y >= self.height + 13px ? self.point-y - self.height - 13px : self.point-y + 13px;
                            background: Graphite.window;
                            border-color: Graphite.divider;
                            border-width: 1px;
                            border-radius: 6px;
                            value := Label {
                                text: (plot.handle-size < 15px ? "Point " + (root.selected-point + 1) + " · " : "")
                                    + point-readout.band.frequency + " Hz · " + point-readout.band.gain-label;
                                accessible-label: self.text;
                                width: parent.width;
                                height: parent.height;
                                color: Graphite.text;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea {
                            enabled: !root.listening-to-a;
                            width: parent.width; height: parent.height;
                            private property <length> last-x;
                            private property <length> last-y;
                            private property <float> drag-x;
                            private property <float> drag-y;
                            private property <bool> right-pressed;
                            double-clicked => {
                                if (plot.active-drag < 0) {
                                    root.add-band(self.mouse-x / self.width, self.mouse-y / self.height,
                                        self.width / 1px, self.height / 1px);
                                }
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    plot.dragging = root.hit-band(self.mouse-x / self.width, self.mouse-y / self.height,
                                        self.width / 1px, self.height / 1px);
                                    plot.pressed-generation = root.drag-generation;
                                    root.selected-point = plot.dragging;
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                    self.drag-x = 0;
                                    self.drag-y = 0;
                                } else if (event.kind == PointerEventKind.move && self.pressed && plot.active-drag >= 0) {
                                    let sensitivity = event.modifiers.shift ? 0.2 : 1.0;
                                    self.drag-x += sensitivity * (self.mouse-x - self.last-x) / self.width;
                                    self.drag-y += sensitivity * (self.mouse-y - self.last-y) / self.height;
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                    plot.dragging = root.move-band(plot.active-drag, self.drag-x, self.drag-y);
                                    if (plot.dragging >= 0) { root.selected-point = plot.dragging; }
                                } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    self.right-pressed = !self.pressed;
                                } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                                    if (self.right-pressed && !self.pressed && self.mouse-x >= 0px && self.mouse-x <= self.width
                                        && self.mouse-y >= 0px && self.mouse-y <= self.height) {
                                        root.delete-band-at(self.mouse-x / self.width, self.mouse-y / self.height,
                                            self.width / 1px, self.height / 1px);
                                    }
                                    self.right-pressed = false;
                                } else if ((event.kind == PointerEventKind.up && event.button == PointerEventButton.left)
                                    || event.kind == PointerEventKind.cancel) {
                                    plot.dragging = -1;
                                    self.right-pressed = false;
                                    root.finish-edit();
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: root.graph-axis-inset;
                    Rectangle {
                        height: 16px; horizontal-stretch: 1;
                        GraphLabel { text: "20 Hz"; x: 0px; }
                        GraphLabel { text: "100"; width: 32px; x: parent.width * 0.233 - self.width / 2; horizontal-alignment: center; }
                        GraphLabel { text: "1k"; width: 32px; x: parent.width * 0.566 - self.width / 2; horizontal-alignment: center; }
                        GraphLabel { text: "10k"; width: 32px; x: parent.width * 0.900 - self.width / 2; horizontal-alignment: center; }
                        GraphLabel { text: "20k"; width: 32px; x: parent.width - self.width; horizontal-alignment: right; }
                    }
                }
                if root.show-clipping: Rectangle { height: 1px; background: Graphite.border; }
                if root.show-clipping: clipping-monitor := HorizontalLayout {
                    height: 31px;
                    spacing: 12px;
                    GraphLabel { text: "OUTPUT PEAK"; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 8px;
                        border-radius: 4px;
                        background: Graphite.border;
                        clip: true;
                        Rectangle {
                            x: 0px; y: 0px;
                            width: parent.width * clamp((root.output-peak-dbfs + 60) / 60, 0, 1);
                            height: parent.height;
                            border-radius: 4px;
                            background: Appearance.accent;
                        }
                    }
                    clip-peak := GraphLabel {
                        width: 98px;
                        horizontal-alignment: right;
                        text: !root.connected ? "— dBFS" : root.output-peak-dbfs <= -1000 ? "−∞ dBFS"
                            : round(root.output-peak-dbfs * 10) / 10 + " dBFS";
                        accessible-label: self.text;
                        color: Graphite.text;
                    }
                    clip-state := GraphLabel {
                        width: 82px;
                        horizontal-alignment: center;
                        text: !root.connected ? "OFFLINE" : root.clipping ? "CLIPPING" : "NO CLIP";
                        accessible-label: self.text;
                        color: root.clipping && root.connected ? Appearance.accent : Graphite.secondary;
                    }
                }
            }
            if !root.short: ResizeGrip {
                x: 12px;
                y: parent.height - self.height - 2px;
                width: parent.width - 24px;
                panel-height <=> root.eq-plot-height; minimum: 130;
                label: "EQ graph height";
                resizing => {
                    // Leave enough scroll room to keep the panel's top fixed while it shrinks.
                    root.eq-resize-scroll-floor = window-scroll.visible-height - window-scroll.content-y;
                }
                resized => { root.save-graph-view(); }
            }
        }
        if root.show-levels: levels-panel := Panel {
            height: root.narrow ? 174px : 116px;
            VerticalLayout {
                padding: Graphite.panel-inset; spacing: Graphite.control-gap;
                PanelHeading { text: "Preamp & Balance"; }
                Rectangle {
                    vertical-stretch: 1;
                    preamp-controls := PreampControls {
                        x: 0px; y: 0px;
                        width: root.narrow ? parent.width : max(340px, (parent.width - 49px) / 2);
                        height: root.narrow ? 58px : parent.height;
                        locked: root.listening-to-a;
                        preamp <=> root.preamp;
                        preamp-entry <=> root.preamp-entry;
                        auto-headroom <=> root.auto-headroom;
                        preamp-label: root.preamp-label;
                        change-preamp(value) => { root.change-preamp(value); }
                        enter-preamp(value) => { root.enter-preamp(value); }
                        change-headroom(enabled) => { root.change-headroom(enabled); }
                        finished => { root.finish-edit(); }
                    }
                    Rectangle {
                        x: root.narrow ? 0px : preamp-controls.width + 24px;
                        y: root.narrow ? 64px : 0px;
                        width: root.narrow ? parent.width : 1px;
                        height: root.narrow ? 1px : parent.height;
                        background: Graphite.divider;
                    }
                    HorizontalLayout {
                        x: root.narrow ? 0px : preamp-controls.width + 49px;
                        y: root.narrow ? 70px : 0px;
                        width: parent.width - self.x;
                        height: root.narrow ? 34px : parent.height;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        balance-heading := Label { text: "BALANCE"; }
                        balance-readout := Text { width: 85px; text: root.balance-label; color: Appearance.accent; }
                        GraphLabel { text: "−"; }
                        Slider {
                            horizontal-stretch: 1;
                            enabled: !root.listening-to-a;
                            minimum: -1; maximum: 1; step: 0.05; value <=> root.balance;
                            Tooltip { text: @markdown("Shift the output toward the left or right channel."); }
                            accessible-label: "Balance";
                            changed(value) => { root.change-balance(value); }
                            released => { root.finish-edit(); }
                        }
                        GraphLabel { text: "+"; }
                        Button {
                            text: "Center"; enabled: !root.listening-to-a;
                            clicked => { root.change-balance(0); root.finish-edit(); }
                            Tooltip { text: @markdown("Reset the balance to the center."); }
                        }
                    }
                }
            }
        }
        if !root.simple-layout && root.show-band-list: Panel {
            vertical-stretch: 0;
            VerticalLayout {
                padding: Graphite.panel-inset; spacing: Graphite.control-gap;
                alignment: start;
                HorizontalLayout {
                    spacing: 12px;
                    cross-axis-alignment: center;
                    points-heading := PanelHeading { text: root.spline-eq ? "Spline Points" : "EQ Bands"; }
                    Button {
                        text: root.fitting-eq ? "Fitting…" : root.spline-eq ? "Use Parametric" : "Use Spline";
                        accessible-label: self.text + " From " + points-heading.text;
                        enabled: !root.listening-to-a && !root.fitting-eq;
                        Tooltip { text: @markdown("Switch editors and keep the current EQ curve."); }
                        clicked => { root.toggle-eq-mode(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Label { text: root.spline-eq ? "Point Count" : "Band Count"; }
                    band-count-control := SpinBox {
                        width: 84px;
                        enabled: !root.listening-to-a;
                        Tooltip { text: root.spline-eq
                            ? @markdown("Set the number of points. The 20 Hz and 20 kHz endpoints are required.")
                            : @markdown("Set the number of editable EQ bands."); }
                        minimum: root.spline-eq ? 2 : 0; maximum: 32; value <=> root.band-count;
                        edited(value) => { root.change-count(value); }
                    }
                }
                for band[index] in root.bands: point-row := Rectangle {
                    private property <bool> selected: root.selected-point == index;
                    private property <bool> stacked: !root.spline-eq && root.width < 700px;
                    height: self.stacked ? 82px : 46px;
                    background: Graphite.window;
                    border-radius: 8px;
                    border-color: self.selected ? Appearance.accent : Graphite.border;
                    border-width: 1px;
                    point-fields := HorizontalLayout {
                        x: 7px; y: 7px;
                        width: root.spline-eq ? 147px : 299px;
                        height: 32px;
                        spacing: 6px;
                        cross-axis-alignment: center;
                        Button {
                            text: index + 1;
                            width: 28px;
                            primary: point-row.selected;
                            enabled: !root.listening-to-a;
                            accessible-label: "Select EQ Point " + (index + 1);
                            accessible-checkable: true;
                            accessible-checked: point-row.selected;
                            clicked => { root.selected-point = index; }
                        }
                        if !root.spline-eq: CheckBox {
                            enabled: !root.listening-to-a;
                            Tooltip { text: @markdown("Enable or disable this filter."); }
                            checked: band.enabled; width: 30px;
                            accessible-label: "Band " + (index + 1) + " enabled";
                            toggled => { root.edit-band-enabled(index, self.checked); }
                        }
                        if !root.spline-eq: Choice {
                            enabled: !root.listening-to-a;
                            Tooltip { text: @markdown("Select a peak, low shelf, or high shelf filter."); }
                            width: 110px; model: ["Peak", "Low shelf", "High shelf"]; current-index: band.kind;
                            selected => { root.edit-band-kind(index, self.current-index); }
                        }
                        frequency := LineEdit {
                            enabled: !root.listening-to-a && !band.locked;
                            Tooltip { text: band.locked ? @markdown("This endpoint has a fixed frequency.") : @markdown("Enter the frequency in Hz."); }
                            width: 85px; text: band.frequency;
                            accessible-label: "Band " + (index + 1) + " frequency";
                            accepted => { root.edit-band-number(index, true, self.text); }
                        }
                        Label { text: "Hz"; width: 22px; }
                    }
                    HorizontalLayout {
                        x: point-row.stacked ? 7px : point-fields.x + point-fields.width + 10px;
                        y: point-row.stacked ? 43px : 7px;
                        width: (point-row.stacked ? parent.width - 7px : delete-button.x - 10px) - self.x;
                        height: 32px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        gain := Slider {
                            enabled: !root.listening-to-a;
                            Tooltip { text: @markdown("Set the filter boost or cut in dB."); }
                            horizontal-stretch: 1; minimum: -24; maximum: 24; step: 0.1; value: band.gain;
                            accessible-label: "Band " + (index + 1) + " gain";
                            changed(value) => { root.edit-band-gain(index, value); }
                            released => { root.finish-edit(); }
                        }
                        Label { text: band.gain-label; width: 72px; horizontal-alignment: right; }
                        if !root.spline-eq: Label { text: "Q"; width: 14px; }
                        if !root.spline-eq: LineEdit {
                            enabled: !root.listening-to-a;
                            Tooltip { text: @markdown("Set Q. Higher values make a peak filter narrower."); }
                            width: 65px; text: band.q;
                            accessible-label: "Band " + (index + 1) + " Q";
                            accepted => { root.edit-band-number(index, false, self.text); }
                        }
                    }
                    delete-button := Button {
                        text: "Delete";
                        x: parent.width - self.width - 7px;
                        y: 7px;
                        width: 62px; height: 32px;
                        accessible-label: "Delete band " + (index + 1);
                        enabled: !root.listening-to-a && !band.locked;
                        Tooltip { text: @markdown("Delete this EQ band."); }
                        clicked => { root.delete-band(index); }
                    }
                }
            }
        }
        if !root.simple-layout && root.notice != "": Text { text: root.notice; color: Appearance.accent; wrap: word-wrap; font-size: 12px; }
        if root.has-now-playing && root.narrow: NowPlayingPanel {
            height: 56px;
            details: root.playback-details;
        }
        Rectangle { min-height: 0px; vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 7px; height: 7px; border-radius: 4px; background: root.connected ? Appearance.accent : Graphite.secondary; }
            Label { text: root.status; font-size: 11px; }
            Label { text: root.title + " · " + root.app-version; font-size: 10px; horizontal-alignment: right; }
        }
    }
    }
    top-controls := VerticalLayout {
        x: root.page-inset;
        y: root.page-inset + (root.simple-layout ? 0px : window-scroll.content-y);
        width: window-scroll.visible-width - 2 * root.page-inset;
        height: root.narrow ? 142px : 118px;
        spacing: root.narrow ? 8px : 14px;
        toolbar := Panel {
            height: root.narrow ? 92px : 56px;
            logo := Image {
                width: 34px; height: 34px; source: root.icon;
                x: Graphite.panel-inset;
                y: root.narrow ? 5px : (parent.height - self.height) / 2;
            }
            app-title := Text {
                text: root.title; color: Graphite.text;
                font-size: root.narrow ? 20px : 22px;
                letter-spacing: -0.35px;
                x: logo.x + logo.width + 10px;
                y: root.narrow ? 5px : 0px;
                height: root.narrow ? 34px : parent.height;
                width: min(self.preferred-width, parent.width - self.x - Graphite.panel-inset - (root.narrow ? 0px : 436px));
                vertical-alignment: center; overflow: elide;
            }
            HorizontalLayout {
                x: root.narrow ? 10px : app-title.x + app-title.width + 10px;
                y: root.narrow ? 44px : 0px;
                height: root.narrow ? 42px : parent.height;
                width: parent.width - self.x - (root.narrow ? 10px : Graphite.panel-inset);
                spacing: root.narrow ? 6px : 10px;
                cross-axis-alignment: center;
                Rectangle {
                    width: 146px; height: 36px; border-radius: 8px;
                    background: Graphite.window;
                    border-color: Graphite.border; border-width: 1px;
                    HorizontalLayout {
                        padding: 2px; spacing: 2px;
                        Button {
                            text: "Simple"; primary: root.simple-layout;
                            Tooltip { text: @markdown("Use Bass, Mid, Treble, Loudness, and preamp."); }
                            clicked => { root.change-layout(true); }
                        }
                        Button {
                            text: "Standard"; primary: !root.simple-layout;
                            Tooltip { text: @markdown("Edit individual EQ bands, preamp, and balance."); }
                            clicked => { root.change-layout(false); }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Undo"; width: 60px; height: 32px; enabled: root.can-undo;
                    Tooltip { text: @markdown("Undo the last EQ action. Up to 15 actions are kept."); }
                    clicked => { root.undo(); }
                }
                preset-menu-button := Button {
                    visible: root.show-preset-button;
                    text: "Select Preset"; width: 108px; height: 32px;
                    Tooltip { text: @markdown("Load and manage EQ presets and output links."); }
                    clicked => {
                        root.preset-overwrite-message = "";
                        preset-menu.show();
                    }
                }
                settings-button := Button {
                    text: "Settings"; width: 72px; height: 32px;
                    Tooltip { text: @markdown("Choose what to display and configure playback."); }
                    clicked => { settings.show(); }
                }
            }
            Rectangle {
                x: 13px; y: parent.height - 1px;
                width: parent.width - 26px; height: 1px;
                background: @linear-gradient(90deg, Appearance.accent 0%, Graphite.border 58%);
            }
        }
        HorizontalLayout {
            height: root.narrow ? 42px : 48px;
            spacing: Graphite.control-gap;
            cross-axis-alignment: center;
            equalizer-box := Panel {
                width: 232px;
                height: parent.height;
                HorizontalLayout {
                    padding-left: Graphite.panel-inset; padding-right: 8px;
                    spacing: 8px; cross-axis-alignment: center;
                    PanelHeading {
                        text: "Equalizer On Off";
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: root.bypass ? "Off" : "On";
                        primary: !root.bypass;
                        width: 48px; height: 32px;
                        accessible-label: "Enable Equalizer";
                        accessible-checkable: true;
                        accessible-checked: !root.bypass;
                        Tooltip { text: @markdown("Turn equalization and stereo balance on or off."); }
                        clicked => {
                            root.bypass = !root.bypass;
                            root.change-bypass(root.bypass);
                        }
                    }
                }
            }
            if root.short && root.show-live-view: Button {
                text: root.open-short-monitor ? "Hide Live Monitor" : "Show Live Monitor";
                accessible-label: root.open-short-monitor ? "Collapse Live Monitor" : "Expand Live Monitor";
                height: 32px;
                clicked => { root.open-short-monitor = !root.open-short-monitor; }
            }
            if root.has-now-playing && !root.narrow: NowPlayingPanel {
                horizontal-stretch: 1;
                height: parent.height;
                details: root.playback-details;
            }
            if !root.has-now-playing || root.narrow: Rectangle { horizontal-stretch: 1; }
        }
    }
    }
    if root.fitting-eq: Panel {
        width: 218px;
        height: 46px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - root.page-inset;
        border-color: Appearance.accent;
        border-radius: 10px;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            cross-axis-alignment: center;
            Spinner {
                width: 30px;
                height: 30px;
                indeterminate: true;
                accessible-label: root.fitting-message;
            }
            Label {
                text: root.fitting-message;
                font-size: 14px;
                color: Graphite.text;
            }
        }
    }
    settings := PopupWindow {
        width: 420px;
        private property <length> form-height: 408px + (root.has-login-start ? 31px : 0px)
            + (root.login-start-error == "" ? 0px : 36px)
            + (root.phase-mode-detail == "" ? 0px : 26px)
            + (root.phase-mode-error == "" ? 0px : 36px);
        height: min(self.form-height, root.height - 20px);
        x: clamp(settings-button.absolute-position.x + settings-button.width - self.width, 10px, root.width - self.width - 10px);
        y: clamp(settings-button.absolute-position.y + settings-button.height + 8px, 10px, root.height - self.height - 10px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Graphite.window;
            border-color: Graphite.border;
            border-width: 1px;
            border-radius: 12px;
            settings-scroll := ScrollView {
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: colors-form.height;
                colors-form := VerticalLayout {
                    width: settings-scroll.content-width;
                    height: max(settings.form-height, self.min-height);
                    private property <string> color-error;
                    function submit(value: string) {
                        self.color-error = root.change-colors(value);
                        if (self.color-error == "") {
                            accent-field.value = Appearance.accent-hex;
                        }
                    }
                    padding: 16px;
                    spacing: 10px;
                    GraphLabel { text: "VIEW"; color: Appearance.accent; }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 8px;
                            CheckBox {
                                text: "Live Monitor"; checked <=> root.show-live-view;
                                Tooltip { text: @markdown("Live visualizations can increase CPU use. Turn off Live Monitor to reduce it."); }
                                toggled => { root.change-live-view(self.checked); }
                            }
                            CheckBox { text: "Band list"; checked <=> root.show-band-list; }
                            CheckBox { text: "Preamp and balance"; checked <=> root.show-levels; }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            CheckBox { text: "Clipping monitor"; checked <=> root.show-clipping; }
                            CheckBox { text: "Spectrum behind EQ"; checked <=> root.show-eq-spectrum; }
                            CheckBox { text: "Select Preset button"; checked <=> root.show-preset-button; }
                            CheckBox {
                                text: "Full screen"; checked <=> root.fullscreen-enabled;
                                Tooltip { text: @markdown("Enter full screen. Press Escape to return to the window."); }
                                toggled => {
                                    let enabled = self.checked;
                                    settings.close();
                                    root.set-fullscreen-mode(enabled);
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Graphite.divider; }
                    GraphLabel { text: "PLAYBACK"; color: Appearance.accent; }
                    HorizontalLayout {
                        spacing: 12px;
                        Label { text: "Output device"; width: 100px; }
                        Choice {
                            model: root.outputs; current-index <=> root.output-index;
                            enabled: root.connected;
                            selected => { root.choose-output(self.current-index); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Label { text: "EQ phase mode"; width: 100px; }
                        Choice {
                            accessible-name: "EQ phase mode";
                            model: root.phase-mode-names;
                            current-index <=> root.phase-mode-index;
                            selected => { root.change-phase-mode(self.current-index); }
                        }
                        Button {
                            text: "i";
                            width: 28px;
                            accessible-label: "About EQ phase modes";
                            clicked => { settings.close(); phase-help.show(); }
                        }
                    }
                    if root.phase-mode-detail != "": Label {
                        text: root.phase-mode-detail; color: Graphite.secondary; wrap: word-wrap;
                    }
                    if root.phase-mode-error != "": Label {
                        text: root.phase-mode-error; color: Appearance.accent; wrap: word-wrap;
                    }
                    if root.has-login-start: CheckBox {
                        text: "Start on login";
                        checked <=> root.login-start;
                        Tooltip { text: @markdown("Open the equalizer when you sign in to your Linux desktop."); }
                        toggled => {
                            root.login-start-error = root.change-login-start(self.checked);
                            if (root.login-start-error != "") { self.checked = !self.checked; }
                        }
                    }
                    if root.login-start-error != "": Label {
                        text: root.login-start-error; color: Appearance.accent; wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: Graphite.divider; }
                    GraphLabel { text: "APPEARANCE"; color: Appearance.accent; }
                    accent-field := ColorField {
                        label: "Accent"; swatch: Appearance.accent; value: Appearance.accent-hex;
                        accepted => { colors-form.submit(self.value); }
                    }
                    if colors-form.color-error != "": Label {
                        text: colors-form.color-error; color: Appearance.accent; wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "Apply color"; clicked => { colors-form.submit(accent-field.value); }
                            Tooltip { text: @markdown("Apply and save the accent color."); }
                        }
                        Button {
                            text: "Reset color"; clicked => { colors-form.submit(Appearance.default-accent-hex); }
                            Tooltip { text: @markdown("Restore the default emerald accent."); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "About";
                            Tooltip { text: @markdown("See the app version, copyright, and licenses."); }
                            clicked => { settings.close(); root.show-about-license = false; about.show(); }
                        }
                    }
                }
            }
        }
    }
    phase-help := PopupWindow {
        width: min(510px, root.width - 20px);
        height: min(500px, root.height - 20px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: no-auto-close;
        forward-focus: close-phase-help;
        function dismiss() {
            phase-help.close();
            settings.show();
        }
        Panel {
            FocusScope {
                width: parent.width;
                height: parent.height;
                capture-key-pressed(event) => {
                    if event.text == Key.Escape {
                        phase-help.dismiss();
                        return accept;
                    }
                    return reject;
                }
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    PanelHeading { text: "EQ phase modes"; }
                    help-scroll := ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        content-height: help-text.height;
                        help-text := VerticalLayout {
                            width: help-scroll.content-width;
                            height: self.min-height;
                            padding-right: 8px;
                            spacing: 12px;
                            Label {
                                text: "Gain sets how loud each frequency is. Phase affects how those frequencies line up in time, especially in short sounds like drum hits.";
                                font-size: 13px;
                                wrap: word-wrap;
                                accessible-label: self.text;
                            }
                            for description[index] in [
                                "The default for everyday listening, video and games. It keeps delay low and changes phase around the frequencies you adjust.",
                                "Approximates the gain and phase of analog peak and shelf filters. The spline curve uses Minimum Phase.",
                                "Frequency components share the same delay, preserving their phase relationships after alignment. Sharp filters can cause pre-ringing, a small oscillation before the main sound.",
                                "Preserves phase after delay compensation, like Linear Phase. A longer filter follows narrow bands more closely. Very narrow bass adjustments are still approximated, and pre-ringing is possible."
                            ]: VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: root.phase-mode-names[index];
                                    font-size: 14px;
                                    color: Graphite.text;
                                    accessible-label: self.text;
                                }
                                Label {
                                    text: description + (root.phase-mode-details[index] == "" ? "" : " " + root.phase-mode-details[index]);
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    accessible-label: self.text;
                                }
                            }
                            Label {
                                text: "The added delay can affect lip sync and live monitoring. This setting applies across presets.";
                                font-size: 13px;
                                wrap: word-wrap;
                                accessible-label: self.text;
                            }
                        }
                    }
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        close-phase-help := Button {
                            text: "Close";
                            clicked => { phase-help.dismiss(); }
                        }
                    }
                }
            }
        }
    }
    preset-load-warning := PopupWindow {
        width: 460px;
        height: 174px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: no-auto-close;
        forward-focus: cancel-preset-load;
        Panel {
            FocusScope {
                width: parent.width;
                height: parent.height;
                capture-key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.finish-preset-load(false);
                        return accept;
                    }
                    return reject;
                }
                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    PanelHeading { text: "Unsaved EQ Changes"; }
                    Label { text: root.preset-load-name; color: Appearance.accent; overflow: elide; }
                    Label {
                        text: "This will replace your unsaved EQ changes. Cancel to keep editing or save them as a preset first.";
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        cancel-preset-load := Button {
                            text: "Cancel";
                            clicked => { root.finish-preset-load(false); }
                        }
                        Button {
                            text: root.preset-load-import ? "Import and Load" : "Load Preset";
                            clicked => { root.finish-preset-load(true); }
                        }
                    }
                }
            }
        }
    }
    band-removal := PopupWindow {
        width: 460px;
        height: 180px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Graphite.window;
            border-color: Graphite.border;
            border-width: 1px;
            border-radius: 12px;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: root.spline-eq ? "Confirm point removal" : "Confirm band removal"; color: Graphite.text; font-size: 19px; }
                Label { text: root.band-removal-message; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Cancel";
                        clicked => { band-removal.close(); root.resolve-band-removal(false); }
                    }
                    Button {
                        text: "Remove";
                        clicked => { band-removal.close(); root.resolve-band-removal(true); }
                    }
                }
            }
        }
    }
    about := PopupWindow {
        width: min(490px, root.width - 20px);
        height: min(350px, root.height - 20px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Graphite.window;
            border-color: Graphite.border;
            border-width: 1px;
            border-radius: 12px;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                if !root.show-about-license: VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        Image { width: 44px; height: 44px; source: root.icon; }
                        VerticalLayout {
                            Text { text: root.title; color: Graphite.text; font-size: 20px; }
                            Label { text: "Version " + root.app-version; }
                        }
                    }
                    Label { text: "Copyright © 2026 Simple Modern Equalizer contributors"; }
                    Label {
                        text: "Project source and Resonance are licensed under " + root.source-license
                            + ". Builds using Slint’s GPL option are distributed under GPLv3.";
                        wrap: word-wrap;
                    }
                    Label { text: "Inter Light uses the SIL Open Font License 1.1."; wrap: word-wrap; }
                    Label {
                        text: "See THIRD_PARTY_NOTICES.md in the source repository for credits and license details.";
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                if root.show-about-license: TextEdit {
                    text: root.license-text;
                    read-only: true;
                    wrap: word-wrap;
                    accessible-label: "GNU General Public License";
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.show-about-license ? "Back to About" : "Read GPLv3";
                        Tooltip { text: @markdown("Switch between About and the full GNU GPLv3 text."); }
                        clicked => { root.show-about-license = !root.show-about-license; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Close";
                        Tooltip { text: @markdown("Close the About section."); }
                        clicked => { about.close(); }
                    }
                }
            }
        }
    }
    preset-menu := PopupWindow {
        width: 440px;
        height: min(root.height - 20px, min(480px, 200px + root.presets.length * 39px
            + (root.preset-overwrite-message == "" ? 0px : 20px)));
        x: clamp(preset-menu-button.absolute-position.x + preset-menu-button.width - self.width, 10px, root.width - self.width - 10px);
        y: clamp(preset-menu-button.absolute-position.y + preset-menu-button.height + 8px, 10px, root.height - self.height - 10px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Graphite.window;
            border-color: Graphite.border;
            border-width: 1px;
            border-radius: 10px;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Save as Preset"; enabled: !root.listening-to-a;
                        Tooltip { text: @markdown("Save the active tuning as a new preset."); }
                        clicked => { name-form.open(false); }
                    }
                    Button {
                        text: "Rename"; enabled: root.can-rename;
                        Tooltip { text: @markdown("Rename the selected custom preset."); }
                        clicked => { name-form.open(true); }
                    }
                    Button {
                        text: "Overwrite Preset"; enabled: root.can-rename && !root.simple-layout;
                        Tooltip { text: @markdown("Replace the selected custom preset with the current Standard tuning."); }
                        clicked => {
                            let error = root.overwrite-preset();
                            root.preset-overwrite-message = error == "" ? "Preset updated." : error;
                        }
                    }
                }
                HorizontalLayout {
                    Button {
                        text: "Import Equalizer APO";
                        enabled: !root.listening-to-a;
                        Tooltip { text: @markdown("Import an Equalizer APO text file and save it as a preset."); }
                        clicked => { preset-menu.close(); root.import-apo(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.preset-overwrite-message != "": Label {
                    text: root.preset-overwrite-message;
                    overflow: elide;
                }
                name-form := VerticalLayout {
                    private property <bool> naming;
                    private property <bool> renaming;
                    private property <string> error;
                    function open(rename: bool) {
                        self.naming = true;
                        self.renaming = rename;
                        self.error = "";
                        preset-name.text = rename && root.preset-index >= 0 ? root.presets[root.preset-index] : "";
                        preset-name.focus();
                    }
                    function submit() {
                        self.error = root.name-preset(self.renaming, preset-name.text);
                        if (self.error == "") { self.naming = false; }
                    }
                    spacing: 4px;
                    HorizontalLayout {
                        visible: name-form.naming;
                        spacing: 6px;
                        preset-name := LineEdit {
                            placeholder-text: "Preset name";
                            Tooltip { text: @markdown("Enter a name for the preset."); }
                            accepted => { name-form.submit(); }
                        }
                        Button { text: "Save"; clicked => { name-form.submit(); } Tooltip { text: @markdown("Save this preset name."); } }
                        Button { text: "Cancel"; clicked => { name-form.naming = false; } Tooltip { text: @markdown("Close without saving."); } }
                    }
                    if self.naming && self.error != "": Label { text: name-form.error; color: Appearance.accent; }
                }
                Label {
                    text: root.active-output-label == "" ? "No active playback output"
                        : root.active-output-label + (root.output-mapping == "" ? "" : " · " + root.output-mapping);
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Use preset for this output"; enabled: root.can-assign;
                        Tooltip { text: @markdown("Load this preset automatically for the current output."); }
                        clicked => { root.assign-preset(true); }
                    }
                    Button {
                        text: "Remove link"; enabled: root.can-unassign;
                        Tooltip { text: @markdown("Remove the preset linked to this output."); }
                        clicked => { root.assign-preset(false); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding: 5px;
                        spacing: 4px;
                        for name[index] in root.presets: Button {
                            text: name + (index == root.preset-index ? " (selected)" : "");
                            Tooltip { text: @markdown("Load this preset."); }
                            height: 35px;
                            clicked => {
                                root.choose-preset(index);
                                preset-menu.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
